NODE_ENV=production
PORT=4000
# Fill explicitly: postgresql://festival:<URL-encoded-password>@postgres:5432/festival
# Must match the Festival postgres credentials, never localhost/Hermes.
DATABASE_URL=
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=10000
DB_IDLE_TRANSACTION_TIMEOUT_MS=10000
ADMIN_JWT_SECRET=
# Exact public HTTPS origin, no trailing slash. Domain is not yet decided.
FRONTEND_ORIGIN=
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
SOCKET_PATH=/socket.io
# Actual KST calendar dates, YYYY-MM-DD, inclusive; not yet decided.
FESTIVAL_START_AT=
FESTIVAL_END_AT=
