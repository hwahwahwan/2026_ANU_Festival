NODE_ENV=development

PORT=3001

DATABASE_URL=

DB_POOL_MAX=

DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=10000
DB_IDLE_TRANSACTION_TIMEOUT_MS=10000

# 32자 이상 필요 (예: `openssl rand -base64 48`로 생성)
ADMIN_JWT_SECRET=

FRONTEND_ORIGIN=http://localhost:3000

# KST(Asia/Seoul) 기준 축제 "운영 날짜"(YYYY-MM-DD, 시각 아님) — 둘 다 그 날짜를
# 포함한다(inclusive). 예: 9/20~9/22 3일 운영이면 FESTIVAL_START_AT=2026-09-20,
# FESTIVAL_END_AT=2026-09-22 (Sales는 다음날 KST 자정을 배타적 상한으로 써서
# [2026-09-20T00:00:00+09:00, 2026-09-23T00:00:00+09:00) 구간을 집계한다).
# 형식이 다르거나(예: 전체 ISO 타임스탬프) 시작이 종료보다 늦으면 서버가 부팅되지
# 않는다(config/env.validation.ts).
FESTIVAL_START_AT=
FESTIVAL_END_AT=

# COOKIE_SAME_SITE는 lax 또는 strict만 허용한다. Frontend/Backend는 항상 동일
# Origin(Nginx Reverse Proxy)으로 배포하므로 none(cross-site)은 지원하지 않는다.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

SOCKET_PATH=/socket.io

# npm run seed:admin 전용 (앱 런타임에는 사용하지 않음, 001_백엔드_공통.md §45 계약에 포함되지 않음)
ADMIN_SEED_USERNAME=
ADMIN_SEED_PASSWORD=

# npm run seed:payment-settings 전용 (앱 런타임에는 사용하지 않음, 001_백엔드_공통.md §45 계약에 포함되지 않음)
PAYMENT_SETTINGS_SEED_BANK_NAME=
PAYMENT_SETTINGS_SEED_ACCOUNT_NUMBER=
PAYMENT_SETTINGS_SEED_ACCOUNT_HOLDER=
